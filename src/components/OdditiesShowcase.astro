---
import { getCollection, render } from 'astro:content';
import Showcase, { type Panel } from './Showcase.astro';
import { t, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const inProgressLabel = t(locale, 'oddities.inProgress');

const entries = (await getCollection('oddities', ({ id, data }) =>
  !data.draft && id.startsWith(`${locale}/`)
)).sort((a, b) => a.data.order - b.data.order);

const panels: Panel[] = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      slug: entry.id.replace(/^[a-z]{2}\//, ''),
      title: entry.data.title,
      meta1: entry.data.years,
      meta2: entry.data.category,
      role: entry.data.format,
      accent: entry.data.accent,
      badges: entry.data.inProgress ? [inProgressLabel] : undefined,
      embed: entry.data.embed,
      link: entry.data.link,
      Content,
    };
  })
);
---

<section class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-[color:var(--color-ink-muted,#475569)]">
    {t(locale, 'oddities.title')}
  </p>
  <h1 class="mt-1 text-3xl font-semibold sm:text-4xl text-[color:var(--color-ink,#0f172a)]">
    {t(locale, 'oddities.subtitle')}
  </h1>
</section>

<Showcase
  panels={panels}
  emptyLabel={t(locale, 'oddities.empty')}
  kbdHint={t(locale, 'oddities.kbdHint')}
  swipeHint={t(locale, 'oddities.swipeHint')}
  prevLabel={t(locale, 'oddities.prev')}
  nextLabel={t(locale, 'oddities.next')}
/>
