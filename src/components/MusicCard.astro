---
import type { CollectionEntry } from 'astro:content';
import Embed from './Embed.astro';

interface Props {
  entry: CollectionEntry<'music'>;
}

const { entry } = Astro.props;
const { title, date, provider, embedUrl, summary, role } = entry.data;
const dateStr = date.toISOString().slice(0, 10);
---

<article class="border border-black/10 rounded-lg p-5">
  <header class="flex items-baseline justify-between gap-4">
    <h3 class="text-lg font-semibold">{title}</h3>
    <time class="text-xs text-[color:var(--color-ink-muted)] font-mono shrink-0">{dateStr}</time>
  </header>
  {role && <p class="mt-1 text-xs uppercase tracking-wide text-[color:var(--color-ink-muted)]">{role}</p>}
  {summary && <p class="mt-2 text-sm text-[color:var(--color-ink-muted)]">{summary}</p>}
  <div class="mt-4">
    <Embed provider={provider} embedUrl={embedUrl} title={title} />
  </div>
</article>
