---
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/music/', label: 'Music' },
  { href: '/teaching/', label: 'Teaching' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="border-b border-black/10">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5">
    <a href="/" class="font-mono text-sm font-semibold no-underline text-[color:var(--color-ink)]">
      /portfolio
    </a>
    <ul class="flex gap-5 text-sm">
      {links.slice(1).map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'no-underline text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-accent)]',
              isActive(href) && 'text-[color:var(--color-accent)] font-medium',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
