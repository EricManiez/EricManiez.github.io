---
import { t, locales, localeNames, defaultLocale, type Locale } from '../i18n/strings';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const otherLocale = locales.find((l) => l !== locale)!;

const links = [
  { href: `/${locale}/engineering/`, label: t(locale, 'nav.engineering'), match: '/engineering' },
  { href: `/${locale}/music/`,       label: t(locale, 'nav.music'),       match: '/music' },
  { href: `/${locale}/teaching/`,    label: t(locale, 'nav.teaching'),    match: '/teaching' },
  { href: `/${locale}/sports/`,      label: t(locale, 'nav.sports'),      match: '/sports' },
  { href: `/${locale}/oddities/`,    label: t(locale, 'nav.oddities'),    match: '/oddities' },
  { href: `/${locale}/contact/`,     label: t(locale, 'nav.contact'),     match: '/contact' },
];

// Swap the current URL's locale segment for the other locale.
const path = Astro.url.pathname;
const otherPath = path.replace(new RegExp(`^/${locale}(/|$)`), `/${otherLocale}$1`);

const isActive = (match: string) => path.includes(match);
---

<header class="border-b border-[color:var(--color-border)]">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4 sm:py-5">
    <a href={`/${locale}/`} class="text-base font-semibold no-underline tracking-tight text-[color:var(--color-ink)]">
      Eric Maniez
    </a>
    <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm sm:gap-x-5">
      {links.map(({ href, label, match }) => (
        <li>
          <a
            href={href}
            class:list={[
              'no-underline text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-accent)]',
              isActive(match) && 'text-[color:var(--color-accent)] font-medium',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
      <li aria-hidden="true" class="text-[color:var(--color-ink-muted)]/40">|</li>
      <li>
        <a
          href={otherPath}
          hreflang={otherLocale}
          class="no-underline font-mono text-xs uppercase tracking-wider text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-accent)]"
          aria-label={`Switch to ${localeNames[otherLocale]}`}
        >
          {otherLocale.toUpperCase()}
        </a>
      </li>
      <li>
        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
          aria-label="Toggle theme"
          title="Toggle theme"
        >
          <span class="theme-ico light" aria-hidden="true">☀</span>
          <span class="theme-ico dark" aria-hidden="true">☾</span>
        </button>
      </li>
    </ul>
  </nav>
</header>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-ink-muted);
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
    transition: color 150ms, border-color 150ms, background 150ms;
  }
  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
  }
  .theme-ico.dark  { display: none; }
  :global(html[data-theme="dark"]) .theme-ico.light { display: none; }
  :global(html[data-theme="dark"]) .theme-ico.dark  { display: inline; }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  if (btn) {
    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (_) { /* private mode etc. */ }
    });
  }
</script>
