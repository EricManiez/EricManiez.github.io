---
// Renders the biking climbs as a sortable table. Reads scraped data from
// src/data/cyclingcols.json; falls back to a hand-curated set of famous cols
// with their canonical stats when no scraped data exists.

interface Col {
  name: string;
  slug?: string;
  country?: string | null;
  times: number;
  elevation?: number | null; // summit meters
  distance?: number | null;  // km
  gain?: number | null;      // meters of elevation gain
  avgSlope?: number | null;  // average slope %
}

const FALLBACK: Col[] = [
  { name: 'Col du Galibier',    country: 'FRA', times: 1, elevation: 2642, distance: 34.8, gain: 2095, avgSlope: 6.0 },
  { name: 'Col d’Izoard',       country: 'FRA', times: 1, elevation: 2360, distance: 14.1, gain: 1095, avgSlope: 7.3 },
  { name: 'Col de la Madeleine', country: 'FRA', times: 1, elevation: 2000, distance: 25.0, gain: 1540, avgSlope: 6.2 },
  { name: 'Col du Granon',      country: 'FRA', times: 1, elevation: 2413, distance: 11.3, gain: 1040, avgSlope: 9.2 },
];

// Eager-load the JSON when it exists; empty object otherwise.
const dataMap = import.meta.glob('/src/data/cyclingcols.json', { eager: true, import: 'default' });
const scraped: any = Object.values(dataMap)[0] ?? null;

const hasScraped = scraped
  && Array.isArray(scraped.uniqueCols)
  && scraped.uniqueCols.length > 0;

const cols: Col[] = hasScraped ? scraped.uniqueCols : FALLBACK;

// Serialize the rows as JSON so the client script can re-sort without
// re-scraping the DOM (also cleaner for numeric comparisons on missing values).
const rows = cols.map((c, i) => ({
  i,
  name: c.name,
  country: c.country ?? '',
  times: c.times ?? 0,
  elevation: c.elevation ?? null,
  distance: c.distance ?? null,
  gain: c.gain ?? null,
  avgSlope: c.avgSlope ?? null,
}));
---

{cols.length === 0 ? (
  <p class="text-sm text-[color:var(--color-ink-muted,#475569)]">No climbs recorded yet.</p>
) : (
  <div class="climbs">
    <div class="climbs-table-wrap">
      <table class="climbs-table">
        <thead>
          <tr>
            <th><button type="button" class="th-btn" data-key="name"      data-type="text">Col</button></th>
            <th><button type="button" class="th-btn" data-key="elevation" data-type="num">Alt.</button></th>
            <th><button type="button" class="th-btn" data-key="distance"  data-type="num">Distance</button></th>
            <th><button type="button" class="th-btn" data-key="gain"      data-type="num">Gain</button></th>
            <th><button type="button" class="th-btn" data-key="avgslope"  data-type="num">Avg slope</button></th>
            <th><button type="button" class="th-btn" data-key="country"   data-type="text">Country</button></th>
            <th><button type="button" class="th-btn" data-key="times"     data-type="num" data-active="desc">Reps</button></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr
              data-name={r.name}
              data-country={r.country}
              data-times={r.times}
              data-elevation={r.elevation ?? ''}
              data-distance={r.distance ?? ''}
              data-gain={r.gain ?? ''}
              data-avgslope={r.avgSlope ?? ''}
            >
              <td class="c-name">{r.name}</td>
              <td class="c-num">{r.elevation != null ? `${r.elevation.toLocaleString()} m` : '—'}</td>
              <td class="c-num">{r.distance != null ? `${r.distance} km` : '—'}</td>
              <td class="c-num">{r.gain != null ? `${r.gain} m` : '—'}</td>
              <td class="c-num">{r.avgSlope != null ? `${r.avgSlope}%` : '—'}</td>
              <td class="c-country">{r.country || '—'}</td>
              <td class="c-num c-reps">{r.times > 1 ? `${r.times}×` : '1'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
)}

<style>
  .climbs { margin-top: 1.5rem; }

  .climbs-table-wrap {
    overflow-x: auto;
    border-radius: 8px;
    border: 1px solid rgb(0 0 0 / 0.1);
  }
  .climbs-table {
    width: 100%;
    border-collapse: collapse;
    font-family: inherit;
    font-size: 0.9rem;
  }
  .climbs-table thead th {
    background: rgb(0 0 0 / 0.02);
    text-align: left;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid rgb(0 0 0 / 0.1);
    white-space: nowrap;
    vertical-align: bottom;
  }
  .th-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.5rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    user-select: none;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted, #475569);
    transition: color 150ms, background 150ms, border-color 150ms;
  }
  /* Neutral (unsorted) affordance — small double arrow on every header. */
  .th-btn::after {
    content: '↕';
    font-size: 0.75rem;
    line-height: 1;
    opacity: 0.4;
    color: currentColor;
    transition: opacity 150ms, color 150ms;
  }
  .th-btn:hover {
    color: var(--accent, #d97706);
    border-color: color-mix(in oklab, var(--accent, #d97706) 25%, transparent);
  }
  .th-btn:hover::after { opacity: 1; }
  .th-btn[data-active] {
    color: var(--accent, #d97706);
    background: color-mix(in oklab, var(--accent, #d97706) 10%, transparent);
    border-color: color-mix(in oklab, var(--accent, #d97706) 30%, transparent);
  }
  .th-btn[data-active="asc"]::after  { content: '↑'; opacity: 1; }
  .th-btn[data-active="desc"]::after { content: '↓'; opacity: 1; }

  .climbs-table thead th:has([data-type="num"]) { text-align: right; }
  .climbs-table td { padding: 0.5rem 0.85rem; border-top: 1px solid rgb(0 0 0 / 0.05); }
  .climbs-table tbody tr:first-child td { border-top: 0; }
  .climbs-table tbody tr { transition: background 120ms; }
  .climbs-table tbody tr:hover { background: color-mix(in oklab, var(--accent, #d97706) 5%, transparent); }

  .c-name { font-weight: 500; color: var(--color-ink, #0f172a); }
  .c-num  { text-align: right; font-family: var(--font-mono, ui-monospace, monospace); font-variant-numeric: tabular-nums; }
  .c-country {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted, #475569);
    text-transform: uppercase;
  }
  .c-reps { color: var(--accent, #d97706); font-weight: 700; }
  .c-num:has-text('—') { color: var(--color-ink-muted, #475569); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.climbs-table').forEach((table) => {
    const tbody = table.querySelector<HTMLElement>('tbody');
    const triggers = Array.from(table.querySelectorAll<HTMLElement>('thead [data-key]'));
    if (!tbody) return;

    function sort(key: string, type: string, dir: 'asc' | 'desc') {
      const rows = Array.from(tbody!.querySelectorAll<HTMLElement>('tr'));
      rows.sort((a, b) => {
        const av = a.dataset[key] ?? '';
        const bv = b.dataset[key] ?? '';
        // Missing values always sort to the bottom, regardless of direction.
        const aMiss = av === '' || av == null;
        const bMiss = bv === '' || bv == null;
        if (aMiss && bMiss) return 0;
        if (aMiss) return 1;
        if (bMiss) return -1;
        let cmp = 0;
        if (type === 'num') {
          cmp = parseFloat(av) - parseFloat(bv);
        } else {
          cmp = av.localeCompare(bv, undefined, { sensitivity: 'base' });
        }
        return dir === 'asc' ? cmp : -cmp;
      });
      rows.forEach((r) => tbody!.appendChild(r));
    }

    triggers.forEach((el) => {
      el.addEventListener('click', () => {
        const key = el.dataset.key!;
        const type = el.dataset.type ?? 'text';
        const currentDir = el.getAttribute('data-active') as 'asc' | 'desc' | null;
        // Default direction: desc for numbers, asc for text; toggle if already active.
        const nextDir: 'asc' | 'desc' = currentDir
          ? (currentDir === 'asc' ? 'desc' : 'asc')
          : (type === 'num' ? 'desc' : 'asc');
        triggers.forEach((t) => t.removeAttribute('data-active'));
        el.setAttribute('data-active', nextDir);
        sort(key, type, nextDir);
      });
    });
  });
</script>
