---
// Renders the biking climbs as a sortable table. Reads scraped data from
// src/data/cyclingcols.json; falls back to a hand-curated set of famous cols
// with their canonical stats when no scraped data exists.

interface Col {
  name: string;
  slug?: string;
  country?: string | null;
  times: number;
  distance?: number | null; // km
  gain?: number | null;     // meters of elevation gain
  avgSlope?: number | null; // average slope %
}

const FALLBACK: Col[] = [
  { name: 'Col du Galibier',    country: 'FRA', times: 1, distance: 34.8, gain: 2095, avgSlope: 6.0 },
  { name: 'Col d’Izoard',       country: 'FRA', times: 1, distance: 14.1, gain: 1095, avgSlope: 7.3 },
  { name: 'Col de la Madeleine', country: 'FRA', times: 1, distance: 25.0, gain: 1540, avgSlope: 6.2 },
  { name: 'Col du Granon',      country: 'FRA', times: 1, distance: 11.3, gain: 1040, avgSlope: 9.2 },
];

// Eager-load the JSON when it exists; empty object otherwise.
const dataMap = import.meta.glob('/src/data/cyclingcols.json', { eager: true, import: 'default' });
const scraped: any = Object.values(dataMap)[0] ?? null;

const hasScraped = scraped
  && Array.isArray(scraped.uniqueCols)
  && scraped.uniqueCols.length > 0;

const cols: Col[] = hasScraped ? scraped.uniqueCols : FALLBACK;
const totalClimbs = hasScraped ? (scraped.eventCount ?? 0) : cols.length;

// Serialize the rows as JSON so the client script can re-sort without
// re-scraping the DOM (also cleaner for numeric comparisons on missing values).
const rows = cols.map((c, i) => ({
  i,
  name: c.name,
  country: c.country ?? '',
  times: c.times ?? 0,
  distance: c.distance ?? null,
  gain: c.gain ?? null,
  avgSlope: c.avgSlope ?? null,
}));
---

{cols.length === 0 ? (
  <p class="text-sm text-[color:var(--color-ink-muted,#475569)]">No climbs recorded yet.</p>
) : (
  <div class="climbs">
    <div class="climbs-summary">
      <span class="stat"><span class="stat-num">{cols.length}</span> cols climbed</span>
      <span class="stat"><span class="stat-num">{totalClimbs}</span> ascents</span>
    </div>

    <div class="climbs-table-wrap">
      <table class="climbs-table">
        <thead>
          <tr>
            <th data-key="name"     data-type="text">Col</th>
            <th data-key="distance" data-type="num">Distance</th>
            <th data-key="gain"     data-type="num">Gain</th>
            <th data-key="avgslope" data-type="num">Avg slope</th>
            <th data-key="country"  data-type="text">Country</th>
            <th data-key="times"    data-type="num" data-active="desc">Reps</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr
              data-name={r.name}
              data-country={r.country}
              data-times={r.times}
              data-distance={r.distance ?? ''}
              data-gain={r.gain ?? ''}
              data-avgslope={r.avgSlope ?? ''}
            >
              <td class="c-name">{r.name}</td>
              <td class="c-num">{r.distance != null ? `${r.distance} km` : '—'}</td>
              <td class="c-num">{r.gain != null ? `${r.gain} m` : '—'}</td>
              <td class="c-num">{r.avgSlope != null ? `${r.avgSlope}%` : '—'}</td>
              <td class="c-country">{r.country || '—'}</td>
              <td class="c-num c-reps">{r.times > 1 ? `${r.times}×` : '1'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
)}

<style>
  .climbs { margin-top: 1.5rem; }

  .climbs-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    padding: 0.9rem 1rem;
    margin-bottom: 1.25rem;
    border-radius: 8px;
    background: color-mix(in oklab, var(--accent, #d97706) 8%, transparent);
    border-left: 4px solid var(--accent, #d97706);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
    color: var(--color-ink, #0f172a);
    letter-spacing: 0.02em;
  }
  .stat { display: inline-flex; align-items: baseline; gap: 0.4rem; }
  .stat-num {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent, #d97706);
    line-height: 1;
  }

  .climbs-table-wrap {
    overflow-x: auto;
    border-radius: 8px;
    border: 1px solid rgb(0 0 0 / 0.1);
  }
  .climbs-table {
    width: 100%;
    border-collapse: collapse;
    font-family: inherit;
    font-size: 0.9rem;
  }
  .climbs-table thead th {
    background: rgb(0 0 0 / 0.02);
    text-align: left;
    padding: 0.6rem 0.85rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted, #475569);
    cursor: pointer;
    user-select: none;
    border-bottom: 1px solid rgb(0 0 0 / 0.1);
    white-space: nowrap;
    transition: color 150ms, background 150ms;
  }
  .climbs-table thead th:hover { color: var(--accent, #d97706); }
  .climbs-table thead th[data-active] {
    color: var(--accent, #d97706);
    background: color-mix(in oklab, var(--accent, #d97706) 6%, transparent);
  }
  .climbs-table thead th[data-active]::after {
    content: '';
    display: inline-block;
    margin-left: 0.35rem;
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    vertical-align: middle;
  }
  .climbs-table thead th[data-active="asc"]::after  { border-bottom: 5px solid var(--accent, #d97706); }
  .climbs-table thead th[data-active="desc"]::after { border-top:    5px solid var(--accent, #d97706); }

  .climbs-table thead th[data-type="num"] { text-align: right; }
  .climbs-table td { padding: 0.5rem 0.85rem; border-top: 1px solid rgb(0 0 0 / 0.05); }
  .climbs-table tbody tr:first-child td { border-top: 0; }
  .climbs-table tbody tr { transition: background 120ms; }
  .climbs-table tbody tr:hover { background: color-mix(in oklab, var(--accent, #d97706) 5%, transparent); }

  .c-name { font-weight: 500; color: var(--color-ink, #0f172a); }
  .c-num  { text-align: right; font-family: var(--font-mono, ui-monospace, monospace); font-variant-numeric: tabular-nums; }
  .c-country {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted, #475569);
    text-transform: uppercase;
  }
  .c-reps { color: var(--accent, #d97706); font-weight: 700; }
  .c-num:has-text('—') { color: var(--color-ink-muted, #475569); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.climbs-table').forEach((table) => {
    const tbody = table.querySelector<HTMLElement>('tbody');
    const headers = Array.from(table.querySelectorAll<HTMLElement>('thead th[data-key]'));
    if (!tbody) return;

    function sort(key: string, type: string, dir: 'asc' | 'desc') {
      const rows = Array.from(tbody!.querySelectorAll<HTMLElement>('tr'));
      rows.sort((a, b) => {
        const av = a.dataset[key] ?? '';
        const bv = b.dataset[key] ?? '';
        // Missing values always sort to the bottom, regardless of direction.
        const aMiss = av === '' || av == null;
        const bMiss = bv === '' || bv == null;
        if (aMiss && bMiss) return 0;
        if (aMiss) return 1;
        if (bMiss) return -1;
        let cmp = 0;
        if (type === 'num') {
          cmp = parseFloat(av) - parseFloat(bv);
        } else {
          cmp = av.localeCompare(bv, undefined, { sensitivity: 'base' });
        }
        return dir === 'asc' ? cmp : -cmp;
      });
      rows.forEach((r) => tbody!.appendChild(r));
    }

    headers.forEach((th) => {
      th.addEventListener('click', () => {
        const key = th.dataset.key!;
        const type = th.dataset.type ?? 'text';
        const currentDir = th.getAttribute('data-active') as 'asc' | 'desc' | null;
        // Default direction: desc for numbers, asc for text; toggle if already active.
        const nextDir: 'asc' | 'desc' = currentDir
          ? (currentDir === 'asc' ? 'desc' : 'asc')
          : (type === 'num' ? 'desc' : 'asc');
        headers.forEach((h) => h.removeAttribute('data-active'));
        th.setAttribute('data-active', nextDir);
        sort(key, type, nextDir);
      });
    });
  });
</script>
