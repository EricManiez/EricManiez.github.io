---
import { getCollection, render } from 'astro:content';
import Embed from './Embed.astro';
import { t, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entries = (await getCollection('music', ({ id, data }) =>
  !data.draft && id.startsWith(`${locale}/`)
)).sort((a, b) => a.data.order - b.data.order);

const panels = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const slugOf = (id: string) => id.replace(/^[a-z]{2}\//, '');
const firstAccent = panels[0]?.entry.data.accent ?? '#d97706';
---

<section class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-[color:var(--color-ink-muted,#475569)]">
    {t(locale, 'music.title')}
  </p>
  <h1 class="mt-1 text-3xl font-semibold sm:text-4xl text-[color:var(--color-ink,#0f172a)]">
    {t(locale, 'music.subtitle')}
  </h1>
</section>

{panels.length === 0 ? (
  <p class="text-sm text-[color:var(--color-ink-muted,#475569)]">{t(locale, 'music.empty')}</p>
) : (
  <div class="showcase" style={`--accent: ${firstAccent}`}>
    <div class="tabs" role="tablist" aria-label="Music projects">
      {panels.map(({ entry }, i) => (
        <button
          type="button"
          class:list={['tab', i === 0 && 'is-active']}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-tab={i}
          data-slug={slugOf(entry.id)}
          style={`--tab-accent: ${entry.data.accent}`}
        >
          <span class="tab-dot" aria-hidden="true"></span>
          <span class="tab-index">{String(i + 1).padStart(2, '0')}</span>
          <span class="tab-label">{entry.data.title}</span>
        </button>
      ))}
    </div>

    <div class="stack">
      {panels.map(({ entry, Content }, i) => (
        <article
          class:list={['panel', i === 0 && 'is-active']}
          data-panel={i}
          data-slug={slugOf(entry.id)}
          data-accent={entry.data.accent}
          aria-hidden={i === 0 ? 'false' : 'true'}
          role="tabpanel"
        >
          <div class="panel-bar" aria-hidden="true"></div>

          <header class="panel-meta">
            <span class="panel-meta-dot" aria-hidden="true"></span>
            <span>{entry.data.years}</span>
            <span aria-hidden="true">·</span>
            <span>{entry.data.genre}</span>
          </header>

          <h2 class="panel-title">{entry.data.title}</h2>
          <p class="panel-role">{entry.data.role}</p>

          <div class="prose prose-slate max-w-none panel-prose">
            <Content />
          </div>

          {entry.data.embed && (
            <div class="panel-embed">
              <Embed
                provider={entry.data.embed.provider}
                embedUrl={entry.data.embed.url}
                title={entry.data.title}
                height={entry.data.embed.height}
              />
            </div>
          )}

          {entry.data.link && (
            <a class="panel-link" href={entry.data.link.url} target="_blank" rel="noopener">
              <span>{entry.data.link.label}</span>
              <span aria-hidden="true">→</span>
            </a>
          )}
        </article>
      ))}
    </div>

    <footer class="controls">
      <div class="controls-left">
        <span class="progress-dot" aria-hidden="true"></span>
        <span id="showcase-progress" class="progress">01 / {String(panels.length).padStart(2, '0')}</span>
        <span class="kbd-hint" aria-hidden="true">
          <span class="kbd-desktop"><kbd>←</kbd> <kbd>→</kbd> {t(locale, 'music.kbdHint')}</span>
          <span class="kbd-mobile">{t(locale, 'music.swipeHint')}</span>
        </span>
      </div>
      <div class="controls-right">
        <button type="button" id="showcase-prev" class="arrow" aria-label={t(locale, 'music.prev')}>
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" id="showcase-next" class="arrow" aria-label={t(locale, 'music.next')}>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </footer>
  </div>
)}

<style>
  .showcase {
    --accent: #d97706;
    --ink: var(--color-ink, #0f172a);
    --ink-muted: var(--color-ink-muted, #475569);
    --transition: 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ---------- Tab bar ---------- */
  .tabs {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-bottom: 1px solid rgb(0 0 0 / 0.1);
    margin-bottom: 2.5rem;
  }
  .tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem 0.85rem;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
    color: var(--ink-muted);
    transition: color var(--transition), background var(--transition);
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    border-radius: 6px 6px 0 0;
  }
  .tab:hover { color: var(--ink); }
  .tab-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--tab-accent, #d97706);
    opacity: 0.35;
    transform: scale(0.75);
    transition: opacity var(--transition), transform var(--transition);
  }
  .tab:hover .tab-dot { opacity: 0.7; }
  .tab.is-active {
    color: var(--ink);
    border-bottom-color: var(--tab-accent, #d97706);
    background: rgba(0, 0, 0, 0.02);
  }
  .tab.is-active .tab-dot {
    opacity: 1;
    transform: scale(1);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--tab-accent, #d97706) 20%, transparent);
  }
  .tab-index {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    opacity: 0.7;
  }
  .tab.is-active .tab-index { color: var(--tab-accent, #d97706); opacity: 1; }
  .tab-label {
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* ---------- Panels (stacked) ---------- */
  .stack {
    display: grid;
    grid-template-areas: "stack";
    touch-action: pan-y;
  }
  .panel {
    grid-area: stack;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    visibility: hidden;
    transition: opacity var(--transition), transform var(--transition), visibility 0s linear var(--transition);
    padding: 0 0 3rem;
  }
  .panel.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
    transition: opacity var(--transition), transform var(--transition), visibility 0s;
  }

  /* Big obvious accent bar at the top of the active panel */
  .panel-bar {
    height: 6px;
    width: 64px;
    border-radius: 999px;
    background: var(--accent);
    margin-bottom: 1.5rem;
    transition: background var(--transition), width var(--transition);
  }
  .panel.is-active .panel-bar { width: 96px; }

  .panel-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .panel-meta-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent);
    transition: background var(--transition);
  }

  .panel-title {
    margin-top: 0.75rem;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .panel-role {
    margin-top: 1rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
    color: var(--ink-muted);
  }
  .panel-prose {
    margin-top: 1.5rem;
    max-width: 42rem;
    color: var(--ink);
  }
  .panel-embed { margin-top: 2rem; }
  .panel-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--accent);
    border-radius: 0.6rem;
    text-decoration: none;
    color: var(--accent);
    font-weight: 500;
    transition: background var(--transition), color var(--transition);
  }
  .panel-link:hover {
    background: var(--accent);
    color: white;
  }

  /* ---------- Controls ---------- */
  .controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(0 0 0 / 0.1);
    flex-wrap: wrap;
  }
  .controls-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .progress-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 20%, transparent);
    transition: background var(--transition), box-shadow var(--transition);
  }
  .progress {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.05em;
    transition: color var(--transition);
  }
  .kbd-hint {
    font-size: 0.7rem;
    color: var(--ink-muted);
    letter-spacing: 0.03em;
    margin-left: 0.5rem;
  }
  .kbd-hint kbd {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    border: 1px solid rgb(0 0 0 / 0.2);
    border-bottom-width: 2px;
    border-radius: 0.25rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    background: rgb(255 255 255 / 0.5);
    color: var(--ink);
  }
  .kbd-mobile { display: none; }
  @media (hover: none) and (pointer: coarse) {
    .kbd-desktop { display: none; }
    .kbd-mobile { display: inline; }
  }

  .controls-right {
    display: flex;
    gap: 0.5rem;
  }
  .arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1.1rem;
    color: var(--accent);
    cursor: pointer;
    transition: background var(--transition), color var(--transition), transform 120ms ease;
  }
  .arrow:hover { background: var(--accent); color: white; }
  .arrow:active { transform: scale(0.95); }
  .arrow:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .panel, .panel-bar, .progress-dot, .tab-dot { transition: opacity 1ms; transform: none; }
    .arrow { transition: none; }
  }
</style>

<script>
  function initShowcase() {
    const showcase = document.querySelector<HTMLElement>('.showcase');
    if (!showcase) return;

    const panels = Array.from(showcase.querySelectorAll<HTMLElement>('[data-panel]'));
    const tabs = Array.from(showcase.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const progress = document.getElementById('showcase-progress');
    const prev = document.getElementById('showcase-prev');
    const next = document.getElementById('showcase-next');
    if (!progress || !prev || !next || panels.length === 0) return;

    let current = 0;

    function apply(i: number) {
      const n = panels.length;
      i = ((i % n) + n) % n;
      current = i;
      panels.forEach((p, k) => {
        p.classList.toggle('is-active', k === i);
        p.setAttribute('aria-hidden', k === i ? 'false' : 'true');
      });
      tabs.forEach((t, k) => {
        t.classList.toggle('is-active', k === i);
        t.setAttribute('aria-selected', k === i ? 'true' : 'false');
      });
      const accent = panels[i].dataset.accent ?? '#d97706';
      showcase!.style.setProperty('--accent', accent);
      progress!.textContent = `${String(i + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}`;
      const slug = panels[i].dataset.slug;
      if (slug) history.replaceState(null, '', `#${slug}`);
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', (e) => { e.preventDefault(); apply(i); }));
    prev.addEventListener('click', () => apply(current - 1));
    next.addEventListener('click', () => apply(current + 1));

    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && target.closest('input, textarea, iframe, [contenteditable]')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); apply(current + 1); }
      if (e.key === 'ArrowLeft')  { e.preventDefault(); apply(current - 1); }
    });

    // ---------- Touch/pointer swipe ----------
    const stack = showcase.querySelector<HTMLElement>('.stack');
    if (stack) {
      let startX: number | null = null;
      let startY: number | null = null;
      let startedInEmbed = false;

      stack.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse') return; // let mouse users click tabs
        startX = e.clientX;
        startY = e.clientY;
        startedInEmbed = !!(e.target as HTMLElement).closest('iframe');
      }, { passive: true });

      stack.addEventListener('pointerup', (e) => {
        if (startX === null || startY === null) return;
        if (startedInEmbed) { startX = null; return; }
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        startX = null; startY = null;
        // Require a mostly-horizontal swipe of at least 50px.
        if (Math.abs(dx) < 50) return;
        if (Math.abs(dx) < Math.abs(dy) * 1.5) return;
        apply(current + (dx < 0 ? 1 : -1));
      }, { passive: true });

      stack.addEventListener('pointercancel', () => { startX = null; startY = null; });
    }

    // Initial from hash if present
    const hashSlug = location.hash.slice(1);
    const initial = panels.findIndex((p) => p.dataset.slug === hashSlug);
    if (initial > 0) apply(initial);
  }

  initShowcase();
</script>
