---
interface Props {
  provider: 'bandcamp' | 'soundcloud' | 'spotify' | 'youtube' | 'googledrive';
  embedUrl: string;
  title: string;
  height?: number;
}

const { provider, embedUrl, title, height } = Astro.props;

const defaults = {
  bandcamp: { height: 470, allow: '' },
  soundcloud: { height: 166, allow: 'autoplay' },
  spotify: { height: 380, allow: 'encrypted-media; autoplay; clipboard-write; picture-in-picture' },
  youtube: { height: 0, allow: 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' },
  googledrive: { height: 720, allow: '' },
}[provider];

const h = height ?? defaults.height;

// Auto-convert a Google Drive sharing URL (/view) to its /preview equivalent.
const src = provider === 'googledrive'
  ? embedUrl.replace(/\/view(\?.*)?$/, '/preview').replace(/\/edit(\?.*)?$/, '/preview')
  : embedUrl;
---

{provider === 'youtube' ? (
  <div class="relative w-full aspect-video overflow-hidden rounded-lg shadow-lg ring-1 ring-black/10">
    <iframe
      src={src}
      title={title}
      loading="lazy"
      allow={defaults.allow}
      allowfullscreen
      class="absolute inset-0 h-full w-full border-0"
    />
  </div>
) : (
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allow={defaults.allow}
    height={h}
    class="w-full border-0 rounded-lg shadow-lg ring-1 ring-black/10"
  />
)}
