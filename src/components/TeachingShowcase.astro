---
import { getCollection, render } from 'astro:content';
import Showcase, { type Panel } from './Showcase.astro';
import { t, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entries = (await getCollection('teaching', ({ id, data }) =>
  !data.draft && id.startsWith(`${locale}/`)
)).sort((a, b) => a.data.order - b.data.order);

const panels: Panel[] = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      slug: entry.id.replace(/^[a-z]{2}\//, ''),
      title: entry.data.title,
      meta1: entry.data.meta1,
      meta2: entry.data.meta2,
      role: entry.data.role,
      accent: entry.data.accent,
      tags: entry.data.tags,
      Content,
    };
  })
);
---

<section class="mb-8">
  <p class="font-mono text-xs uppercase tracking-widest text-[color:var(--color-ink-muted,#475569)]">
    {t(locale, 'teaching.title')}
  </p>
  <h1 class="mt-1 text-3xl font-semibold sm:text-4xl text-[color:var(--color-ink,#0f172a)]">
    {t(locale, 'teaching.subtitle')}
  </h1>
</section>

<Showcase
  panels={panels}
  emptyLabel={t(locale, 'teaching.empty')}
  kbdHint={t(locale, 'teaching.kbdHint')}
  swipeHint={t(locale, 'teaching.swipeHint')}
  prevLabel={t(locale, 'teaching.prev')}
  nextLabel={t(locale, 'teaching.next')}
/>
