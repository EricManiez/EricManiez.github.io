---
import { t, defaultLocale, type Locale } from '../i18n/strings';
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[color:var(--color-border)]">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-6 text-xs text-[color:var(--color-ink-muted)]">
    <span>© {year}</span>
    <span class="font-mono">{t(locale, 'footer.built')}</span>
  </div>
</footer>
