---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Eric Maniez — Developer, Musician, Teacher"
  description="Creative spirit, at the intersection of art & technology."
>
  <section class="mb-16">
    <p class="font-mono text-xs uppercase tracking-widest text-[color:var(--color-ink-muted)]">Lyon, France</p>
    <h1 class="mt-2 text-4xl font-semibold leading-tight sm:text-5xl">
      Creative spirit, at the intersection of art & technology.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-[color:var(--color-ink-muted)]">
      Software developer, music teacher, artist. I help people accomplish their
      creative and entrepreneurial vision — whatever the field.
    </p>
    <div class="mt-8 flex flex-wrap gap-4 text-sm">
      <a href="/projects/" class="no-underline rounded-md border border-[color:var(--color-accent)] px-4 py-2 text-[color:var(--color-accent)] hover:bg-[color:var(--color-accent)] hover:text-white">
        See projects →
      </a>
      <a href="/music/" class="no-underline rounded-md border border-black/20 px-4 py-2 text-[color:var(--color-ink)] hover:border-[color:var(--color-accent)]">
        Listen to music →
      </a>
      <a href="/teaching/" class="no-underline rounded-md border border-black/20 px-4 py-2 text-[color:var(--color-ink)] hover:border-[color:var(--color-accent)]">
        Teaching →
      </a>
    </div>
  </section>

  {projects.length > 0 && (
    <section>
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-xl font-semibold">Featured projects</h2>
        <a href="/projects/" class="text-sm">All projects →</a>
      </div>
      <div class="grid gap-4">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}
</BaseLayout>
