---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MusicCard from '../../components/MusicCard.astro';

const tracks = (await getCollection('music', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Music" description="Recordings, collaborations, and other sonic work.">
  <h1 class="text-3xl font-semibold">Music</h1>
  <p class="mt-2 text-[color:var(--color-ink-muted)]">Recordings, collaborations, and other sonic work.</p>

  {tracks.length === 0 ? (
    <p class="mt-8 text-sm text-[color:var(--color-ink-muted)]">No tracks published yet.</p>
  ) : (
    <div class="mt-8 grid gap-6">
      {tracks.map((entry) => <MusicCard entry={entry} />)}
    </div>
  )}
</BaseLayout>
