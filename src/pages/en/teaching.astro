---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/strings';
const locale = 'en';
---

<BaseLayout
  title="Teaching — Eric Maniez"
  description={t(locale, 'teaching.subtitle')}
>
  <h1 class="text-3xl font-semibold">{t(locale, 'teaching.title')}</h1>
  <p class="mt-2 text-[color:var(--color-ink-muted)]">
    {t(locale, 'teaching.subtitle')}
  </p>

  <section class="prose prose-slate mt-8 max-w-none">
    <h2>What I teach</h2>
    <p>
      Replace this text with your teaching philosophy — instruments, styles,
      ages, formats (in-person, remote), and what a typical lesson looks like.
    </p>

    <h2>Who it's for</h2>
    <p>
      Describe the students you work best with: beginners, intermediate
      players, adults returning to an instrument, students preparing for
      auditions, etc.
    </p>

    <h2>Formats & rates</h2>
    <ul>
      <li>1:1 private lessons — weekly or biweekly.</li>
      <li>Group workshops — small-cohort, project-based.</li>
      <li>One-off consultations — arrangement, production, practice coaching.</li>
    </ul>

    <h2>Get in touch</h2>
    <p>
      Interested in lessons or a workshop?
      <a href="/en/about/#contact">Send me a message</a>.
    </p>
  </section>
</BaseLayout>
