---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/strings';

const locale = 'en';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ id, data }) =>
    !data.draft && id.startsWith('en/')
  );
  return projects.map((project) => ({
    params: { slug: project.id.slice('en/'.length) },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, date, tags, repo, url, cover } = project.data;
const dateStr = date.toISOString().slice(0, 10);
---

<BaseLayout title={`${title} — ${t(locale, 'projects.title')}`} description={summary} image={cover}>
  <a href={`/${locale}/projects/`} class="text-sm">{t(locale, 'projects.back')}</a>

  <header class="mt-6 border-b border-black/10 pb-6">
    <h1 class="text-3xl font-semibold">{title}</h1>
    <p class="mt-2 text-[color:var(--color-ink-muted)]">{summary}</p>
    <div class="mt-3 flex flex-wrap items-center gap-4 text-xs font-mono text-[color:var(--color-ink-muted)]">
      <time>{dateStr}</time>
      {tags.map((tag) => <span>#{tag}</span>)}
    </div>
    {(repo || url) && (
      <div class="mt-4 flex gap-4 text-sm">
        {url && <a href={url} target="_blank" rel="noopener">{t(locale, 'projects.visit')}</a>}
        {repo && <a href={repo} target="_blank" rel="noopener">{t(locale, 'projects.source')}</a>}
      </div>
    )}
  </header>

  <div class="prose prose-slate mt-8 max-w-none">
    <Content />
  </div>
</BaseLayout>
