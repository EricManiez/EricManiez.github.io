---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, date, tags, repo, url, cover } = project.data;
const dateStr = date.toISOString().slice(0, 10);
---

<BaseLayout title={`${title} — Projects`} description={summary} image={cover}>
  <a href="/projects/" class="text-sm">← All projects</a>

  <header class="mt-6 border-b border-black/10 pb-6">
    <h1 class="text-3xl font-semibold">{title}</h1>
    <p class="mt-2 text-[color:var(--color-ink-muted)]">{summary}</p>
    <div class="mt-3 flex flex-wrap items-center gap-4 text-xs font-mono text-[color:var(--color-ink-muted)]">
      <time>{dateStr}</time>
      {tags.map((tag) => <span>#{tag}</span>)}
    </div>
    {(repo || url) && (
      <div class="mt-4 flex gap-4 text-sm">
        {url && <a href={url} target="_blank" rel="noopener">Visit ↗</a>}
        {repo && <a href={repo} target="_blank" rel="noopener">Source ↗</a>}
      </div>
    )}
  </header>

  <div class="prose prose-slate mt-8 max-w-none">
    <Content />
  </div>
</BaseLayout>
